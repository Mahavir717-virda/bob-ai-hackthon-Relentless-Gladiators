# =============================================================================
# HACKATHON SUBMISSION — .gitignore
# =============================================================================
# IMPORTANT: Never commit secrets, credentials, or large binary files.

# ── Secrets & Environment ─────────────────────────────────────────────────────
.env
.env.local
.env.production
.kaggle/
kaggle.json
*.key
*.pem
*.p12
secrets/

# ── Python & ML ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.Python
venv/
.venv/
env/
pip-log.txt
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.coverage
htmlcov/
*.pkl
*.joblib
*.onnx
*.pt
*.pth


# ── Node.js ───────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn
dist/
.next/
.nuxt/
.output/
.cache/

# ── Java / Maven / Gradle ────────────────────────────────────────────────────
target/
*.class
*.jar
*.war
.gradle/
build/

# ── Go ────────────────────────────────────────────────────────────────────────
vendor/
*.exe

# ── Rust ──────────────────────────────────────────────────────────────────────
target/
Cargo.lock  # remove this line if you want to commit lock file (recommended for apps)

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── Windows ───────────────────────────────────────────────────────────────────
Thumbs.db
desktop.ini

# ── IDEs & Editors ────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ── Large Media Files (use demo-video-link.txt instead) ───────────────────────
demo/*.mp4
demo/*.mov
demo/*.avi
demo/*.mkv

# ── Docker volumes / local data ───────────────────────────────────────────────
data/
!docs/data/
!services/data/
ml/datasets/raw/
ml/datasets/kaggle_power_system/
*.zip
logs/
TEAM_LEADER_PLAYBOOK.md
GridPilot_Bob_Usage_Plan.md
GridPilot_U2_8Hour_Execution_Plan.md
*.log

# ── Jupyter Notebooks (optional: remove if you want to commit notebooks) ──────
# .ipynb_checkpoints/

# ── Terraform ─────────────────────────────────────────────────────────────────
.terraform/
*.tfstate
*.tfstate.backup

# Local renewable datasets and generated training artifacts
ml/datasets/kaggle_power_system/
ml/datasets/liander2024/
ml/models/renewable/artifacts/

# Documentation and deployable renewable artifacts intentionally kept in Git
!docs/data/
!docs/data/**
!ml/models/renewable/wind_lgbm_wind_park_synth_01.pkl
!ml/models/renewable/solar_lgbm_solar_park_synth_01.pkl
!ml/models/renewable/root_cause_xgb_solar.pkl
!ml/models/renewable/root_cause_xgb_wind.pkl
