{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@gridpilot/shared/*": ["./shared/*"]
    }
  },
  "include": [
    "shared/**/*",
    "apps/api/**/*",
    "agent/**/*",
    "tests/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "apps/web"
  ]
}
