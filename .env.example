# ==============================================================================
# GridPilot AI — Environment Configuration Example
# ==============================================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the real .env file — it is in .gitignore.

# --- LLM Provider Configuration (watsonx | ollama | mock) ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b

# --- IBM watsonx.ai Configuration ---
WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# --- IBM Bob / MCP Server Configuration ---
BOB_MCP_SERVER_PORT=3001
BOB_AGENT_LOG_LEVEL=info

# --- API Gateway Configuration ---
PORT=8000
API_HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# --- Frontend Web Configuration ---
VITE_API_BASE_URL=http://localhost:8000

# --- PostgreSQL Database ---
DATABASE_URL=postgresql://gridpilot:gridpilot_password@localhost:5432/gridpilot_db
POSTGRES_USER=gridpilot
POSTGRES_PASSWORD=gridpilot_password
POSTGRES_DB=gridpilot_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Analytical Services Ports ---
DATA_SERVICE_PORT=8001
FORECASTING_SERVICE_PORT=8002
RENEWABLE_SERVICE_PORT=8003
OPTIMIZATION_SERVICE_PORT=8004

# --- Grid Configuration & Constants ---
GRID_ZONE_ID=NL_LIANDER_ZONE_1
GRID_TIME_STEP_MINUTES=15
OPTIMIZATION_SOLVER_TIMEOUT_MS=5000
